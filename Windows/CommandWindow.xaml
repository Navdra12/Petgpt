<Window x:Class="PetGPT.Windows.CommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PetGPT Commands"
        Width="430" Height="230"
        MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Local PetGPT command"
                   FontWeight="SemiBold"/>
        <TextBox x:Name="CommandTextBox"
                 Grid.Row="1"
                 Margin="0,8,0,10"
                 MaxLength="128"
                 ToolTip="Commands entered here stay local and are never sent to ChatGPT"
                 KeyDown="OnCommandKeyDown"/>
        <TextBox x:Name="ResultTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 Text="Commands: /pet, /pet list, /pet &lt;id&gt;, /pet sleep, /pet wake, /theme, /history, /new"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Run" Padding="18,6" Margin="0,0,8,0" IsDefault="True" Click="OnRun"/>
            <Button Content="Close" Padding="18,6" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
